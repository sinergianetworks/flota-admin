# ─────────────────────────────────────────────────────────────
# Flota Admin · secrets de las edge functions
#
# Copia este archivo como supabase/functions/.env, complétalo y súbelo con:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# NO lo subas al repositorio. SUPABASE_URL y las API keys las inyecta
# Supabase automáticamente: no hace falta definirlas.
# ─────────────────────────────────────────────────────────────

# Zona horaria de la instalación (IANA). Igual que APP_TIMEZONE del contenedor web.
APP_TIMEZONE=America/Mexico_City

# Secreto compartido con pg_cron para llamar a sync-mileage (mín. 16 caracteres).
# Genera uno con:  openssl rand -hex 32
# El mismo valor se guarda en Vault como 'flota_sync_secret' (ver docs/INSTALACION.md).
SYNC_CRON_SECRET=

# ── Proveedor GPS: Tracksolid Pro (opcional) ─────────────────
# Déjalos vacíos si no usas Tracksolid. Se obtienen de la cuenta de
# desarrollador de Tracksolid Pro (Jimi IoT).
TRACKSOLID_APP_KEY=
TRACKSOLID_APP_SECRET=
# Usuario (login) de la cuenta Tracksolid
TRACKSOLID_USER_ID=
# MD5 de la contraseña de ese usuario, en minúsculas (32 caracteres). Genéralo con:
#   printf '%s' 'tu-contraseña' | md5          (macOS)
#   printf '%s' 'tu-contraseña' | md5sum       (Linux)
TRACKSOLID_USER_PWD_MD5=
# Opcional: cuenta cuyos equipos se listan (por defecto TRACKSOLID_USER_ID)
# TRACKSOLID_TARGET=
# Opcional: endpoint regional (por defecto https://us-open.tracksolidpro.com/route/rest)
# TRACKSOLID_BASE_URL=

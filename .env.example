# ─────────────────────────────────────────────────────────────
# Flota Admin · variables del contenedor web
#
# Copia este archivo como .env y completa los valores. Se leen al ARRANCAR
# el contenedor (no al construir la imagen): tras cambiarlas, reinícialo.
#
# Todo lo que está aquí llega al navegador. Solo valores públicos:
# NUNCA pongas la secret key ni la service_role key.
# ─────────────────────────────────────────────────────────────

# ── Supabase (obligatorias) ──────────────────────────────────
# Panel de Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Solo para proyectos que todavía usan las keys legacy: la "anon" key (un JWT).
# Si defines SUPABASE_PUBLISHABLE_KEY, esta se ignora.
# SUPABASE_ANON_KEY=

# ── Zona horaria (obligatoria) ───────────────────────────────
# Nombre IANA. Define qué es "hoy" al agrupar los km por día.
# Debe ser IGUAL al secret APP_TIMEZONE de las edge functions.
# Ejemplos: America/Mexico_City, America/Bogota, America/Lima, Europe/Madrid
APP_TIMEZONE=America/Mexico_City

# ── Marca (opcionales) ───────────────────────────────────────
# Nombre que se muestra en el login, el menú y la pestaña del navegador.
APP_NAME=Flota Admin

# URL de un logo (PNG/SVG cuadrado). Vacío = logo neutro incluido.
# APP_LOGO_URL=https://tu-dominio.com/logo.png

# Color primario en hex (#RRGGBB). Vacío = azul por defecto.
# APP_PRIMARY_COLOR=#2563eb

# Símbolo de moneda para los costos de la bitácora. Por defecto: $
# APP_CURRENCY=$

# ── Docker Compose (opcional) ────────────────────────────────
# Puerto del host donde se publica la app.
# FLOTA_PORT=8080
